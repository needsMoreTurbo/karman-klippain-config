.theme/
.moonraker.uuid
*.csv
*.bkp
save_variables.cfg
.venv/
*.bak

# Python bytecode from tools/
__pycache__/
*.pyc

# Generated by tools/visualize_toolchange.py (regenerate with: uv run tools/visualize_toolchange.py)
tools/toolchange_viz.html

# Generated by physics/ (regenerate: extract_traces.py, then fit_model.py, then melt_model.py).
# physics/captures/ is the raw measurement data and IS tracked — it cannot be regenerated.
physics/measured.json
physics/fit_result.json
physics/melt_model_out.json

# Generated by tools/hh_extract.py (regenerate: uv run tools/hh_extract.py)
tools/hh_extract.json
tools/hh_extract_report.txt

# HelixScreen runtime state. The rest of helixscreen/ IS tracked — it is the app config.
helixscreen/crash_history.json

# Claude Code per-machine settings; the shared config is .claude/settings.json and IS tracked.
.claude/settings.local.json

# Installer backups, e.g. the moonraker.conf.bak.helixscreen the HelixScreen installer drops.
# (Plain *.bak is already covered above; this catches the .bak.<suffix> form.)
*.bak.*

# Stray g-code archives that land in the config dir from Mainsail downloads.
gcodes-*.zip
